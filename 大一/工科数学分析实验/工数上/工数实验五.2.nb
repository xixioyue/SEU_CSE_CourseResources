Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"f", "[", "x_", "]"}], ":=", 
   RowBox[{"Sin", "[", 
    RowBox[{"x", "^", "2"}], "]"}]}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{"a", "=", "0"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"b", "=", 
   RowBox[{"Pi", "/", "2"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"m2", "=", 
   RowBox[{"N", "[", 
    RowBox[{
     RowBox[{"D", "[", 
      RowBox[{
       RowBox[{"D", "[", 
        RowBox[{
         RowBox[{"f", "[", "x", "]"}], ",", "x"}], "]"}], ",", "x"}], "]"}], "/.", 
     RowBox[{"x", "\[Rule]", "0"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"m4", "=", 
    RowBox[{"N", "[", 
     RowBox[{
      RowBox[{"D", "[", 
       RowBox[{
        RowBox[{"D", "[", 
         RowBox[{
          RowBox[{"D", "[", 
           RowBox[{
            RowBox[{"D", "[", 
             RowBox[{
              RowBox[{"f", "[", "x", "]"}], ",", "x"}], "]"}], ",", "x"}], 
           "]"}], ",", "x"}], "]"}], ",", "x"}], "]"}], "/.", 
      RowBox[{"x", "\[Rule]", "0"}]}], "]"}]}], ";", 
   RowBox[{"delta", "=", 
    RowBox[{"10", "^", 
     RowBox[{"-", "4"}]}]}], ";", 
   RowBox[{"n0", "=", "40"}], ";", 
   RowBox[{
    RowBox[{"t", "[", "n_", "]"}], ":=", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{"b", "-", "a"}], ")"}], "/", "n"}], "*", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"f", "[", "a", "]"}], "+", 
          RowBox[{"f", "[", "b", "]"}]}], ")"}], "/", "2"}], "+", 
       RowBox[{"Sum", "[", 
        RowBox[{
         RowBox[{"f", "[", 
          RowBox[{"a", "+", 
           RowBox[{"i", "*", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"b", "-", "a"}], ")"}], "/", "n"}]}]}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "1", ",", 
           RowBox[{"n", "-", "1"}]}], "}"}]}], "]"}]}], ")"}]}]}]}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"SimpsonsRule", "[", 
    RowBox[{"a_", ",", "b_", ",", "n_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"h", ",", "xValues", ",", "sum1", ",", "sum2"}], "}"}], ",", 
     RowBox[{
      RowBox[{"h", "=", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"b", "-", "a"}], ")"}], "/", "n"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"xValues", "=", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"a", "+", 
          RowBox[{"i", "*", "h"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "0", ",", "n"}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"sum1", "=", 
       RowBox[{"Sum", "[", 
        RowBox[{
         RowBox[{"f", "[", 
          RowBox[{"xValues", "[", 
           RowBox[{"[", 
            RowBox[{"2", "*", "i"}], "]"}], "]"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "1", ",", 
           RowBox[{"n", "/", "2"}]}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"sum2", "=", 
       RowBox[{"Sum", "[", 
        RowBox[{
         RowBox[{"f", "[", 
          RowBox[{"xValues", "[", 
           RowBox[{"[", 
            RowBox[{
             RowBox[{"2", "*", "i"}], "-", "1"}], "]"}], "]"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"i", ",", "1", ",", 
           RowBox[{"n", "/", "2"}]}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"h", "/", "3"}], ")"}], "*", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"f", "[", 
          RowBox[{"First", "[", "xValues", "]"}], "]"}], "+", 
         RowBox[{"f", "[", 
          RowBox[{"Last", "[", "xValues", "]"}], "]"}], "+", 
         RowBox[{"4", "*", "sum2"}], "+", 
         RowBox[{"2", "*", "sum1"}]}], ")"}]}]}]}], "]"}]}], 
  "\[IndentingNewLine]", "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
  "Print", "[", "\"\<\:68af\:5f62\:6cd5\:8ba1\:7b97\:7ed3\:679c\:ff1a\>\"", 
   "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", "\"\<----------------\>\"", "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"n", "=", "1"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"While", "[", 
   RowBox[{"True", ",", 
    RowBox[{
     RowBox[{"result", "=", 
      RowBox[{"N", "[", 
       RowBox[{"t", "[", "n", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{
       RowBox[{"NumberForm", "[", 
        RowBox[{
         RowBox[{"N", "[", "n", "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"8", ",", "6"}], "}"}]}], "]"}], ",", "\"\<  \>\"", ",", 
       RowBox[{"NumberForm", "[", 
        RowBox[{"result", ",", 
         RowBox[{"{", 
          RowBox[{"8", ",", "6"}], "}"}]}], "]"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"error", "=", 
      RowBox[{"Abs", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"b", "-", "a"}], ")"}], "^", "3"}], "/", 
         RowBox[{"(", 
          RowBox[{"12", "*", 
           RowBox[{"n", "^", "2"}]}], ")"}]}], "*", "m2"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"error", "<", "delta"}], ",", 
       RowBox[{"Break", "[", "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"n", "\[Equal]", "n0"}], ",", 
       RowBox[{"Break", "[", "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
     RowBox[{"n", "=", 
      RowBox[{"n", "+", "1"}]}], ";"}]}], "]"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"a", "=", "0.0"}], ";"}], "\n", 
