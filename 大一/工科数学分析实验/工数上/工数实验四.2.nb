Notebook[{

Cell[CellGroupData[{
Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"f", "[", "x_", "]"}], ":=", 
   RowBox[{"Log", "[", 
    RowBox[{
     RowBox[{"Cos", "[", 
      RowBox[{"x", "^", "2"}], "]"}], "+", 
     RowBox[{"Sin", "[", "x", "]"}]}], "]"}]}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{"xmin", "=", 
   RowBox[{
    RowBox[{"-", "Pi"}], "/", "4"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"xmax", "=", 
    RowBox[{"Pi", "/", "4"}]}], ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{"Plot", "[", 
   RowBox[{
    RowBox[{"f", "[", "x", "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"x", ",", "xmin", ",", "xmax"}], "}"}]}], "]"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"TaylorSeries", "[", 
    RowBox[{"x0_", ",", "n_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", "series", "}"}], ",", 
     RowBox[{
      RowBox[{"series", "=", 
       RowBox[{"Normal", "[", 
        RowBox[{"Series", "[", 
         RowBox[{
          RowBox[{"f", "[", "x", "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"x", ",", "x0", ",", "n"}], "}"}]}], "]"}], "]"}]}], ";", 
      RowBox[{"Return", "[", "series", "]"}]}]}], "]"}]}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"ComparisonPlot", "[", 
    RowBox[{"x0_", ",", "nterms_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", "taylor", "}"}], ",", 
     RowBox[{
      RowBox[{"taylor", "=", 
       RowBox[{"TaylorSeries", "[", 
        RowBox[{"x0", ",", "nterms"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"Plot", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"f", "[", "x", "]"}], ",", "taylor"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"x", ",", "xmin", ",", "xmax"}], "}"}], ",", 
        RowBox[{"PlotStyle", "\[Rule]", 
         RowBox[{"{", 
          RowBox[{"Blue", ",", "Red"}], "}"}]}], ",", 
        RowBox[{"PlotLegends", "\[Rule]", 
         RowBox[{"{", 
          RowBox[{"\"\<Original Function\>\"", ",", 
           RowBox[{"StringForm", "[", 
            RowBox[{
            "\"\<Taylor Series at x0=`1` (n=`2`)\>\"", ",", "x0", ",", 
             "nterms"}], "]"}]}], "}"}]}], ",", 
        RowBox[{"AxesLabel", "\[Rule]", 
         RowBox[{"{", 
          RowBox[{"\"\<x\>\"", ",", "\"\<y\>\""}], "}"}]}], ",", 
        RowBox[{"PlotLabel", "\[Rule]", 
         RowBox[{"StringForm", "[", 
          RowBox[{"\"\<Taylor Series Expansion at x0=`1`\>\"", ",", "x0"}], 
          "]"}]}], ",", 
        RowBox[{"GridLines", "\[Rule]", "Automatic"}]}], "]"}]}]}], "]"}]}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"x0Values", "=", 
   RowBox[{"{", 
    RowBox[{"0", ",", 
     RowBox[{"Pi", "/", "8"}], ",", 
     RowBox[{
      RowBox[{"-", "Pi"}], "/", "8"}]}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Grid", "[", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"Column", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"ComparisonPlot", "[", 
         RowBox[{"x0", ",", "4"}], "]"}], ",", 
        RowBox[{"ComparisonPlot", "[", 
         RowBox[{"x0", ",", "7"}], "]"}]}], "}"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"x0", ",", "x0Values"}], "}"}]}], "]"}], "]"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"TaylorCoefficients", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"D", "[", 
       RowBox[{
        RowBox[{"f", "[", "x", "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"x", ",", "n"}], "}"}]}], "]"}], "/.", 
      RowBox[{"x", "\[Rule]", "0"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"n", ",", "0", ",", "7"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", "\"\<Taylor coefficients at x0=0:\>\"", "]"}], 
  ";"}], "\n", 
 RowBox[{"TableForm", "[", 
  RowBox[{
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"n", ",", 
       RowBox[{"TaylorCoefficients", "[", 
        RowBox[{"[", 
         RowBox[{"n", "+", "1"}], "]"}], "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"n", ",", "0", ",", "7"}], "}"}]}], "]"}], ",", 
   RowBox[{"TableHeadings", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"None", ",", 
      RowBox[{"{", 
       RowBox[{"\"\<Order\>\"", ",", "\"\<Coefficient\>\""}], "}"}]}], 
     "}"}]}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.9439238517912784`*^9, 3.943923919846979*^9}, {
   3.943924018191849*^9, 3.943924076889053*^9}, 3.943924116400988*^9}],

